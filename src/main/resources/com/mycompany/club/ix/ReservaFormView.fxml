<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="250.0" prefWidth="400.0" spacing="20.0" style="-fx-background-color: white;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.club.ix.ReservaFormViewController">
   <children>
      <HBox spacing="10.0">
         <children>
            <Label text="Formulario de Reserva" textFill="#244163">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="lblSocioInfo" text="(socio ya cargado)" textFill="#666666">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
      <VBox spacing="5.0">
         <children>
            <Label text="Espacio" textFill="#555555" />
            <TextField fx:id="txtEspacio" style="-fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4;" text="Cancha 2" />
         </children>
      </VBox>
      <Label fx:id="lblHorario" text="Sábado 18:00 - 19:00" textFill="#333333" />
      <HBox spacing="15.0">
         <children>
            <Button fx:id="btnConfirmar" mnemonicParsing="false" onAction="#onConfirmar" prefWidth="100.0" style="-fx-background-color: #3f9e67; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Confirmar" />
            <Button fx:id="btnDeshacer" mnemonicParsing="false" onAction="#onDeshacer" prefWidth="100.0" style="-fx-background-color: #c09439; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Deshacer" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>
