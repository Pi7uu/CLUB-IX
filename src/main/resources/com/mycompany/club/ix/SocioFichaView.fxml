<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="450.0" spacing="15.0" style="-fx-background-color: white;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.club.ix.SocioFichaViewController">
   <children>
      <VBox spacing="5.0">
         <children>
            <Label text="Ficha de Socio" textFill="#244163">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label fx:id="lblRecibeSocio" text="Recibe: Socio J. Fernández" textFill="#666666" />
         </children>
      </VBox>
      <TextField fx:id="txtEstado" editable="false" style="-fx-background-radius: 4; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-color: transparent;" text="Estado ACTIVO" />
      <VBox spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Cuotas (historial)" textFill="#244163">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <TableView fx:id="tableCuotas" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colPeriodo" prefWidth="200.0" text="Período" />
                <TableColumn fx:id="colEstado" prefWidth="200.0" text="Estado" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <Button fx:id="btnNuevaReserva" mnemonicParsing="false" onAction="#onNuevaReserva" style="-fx-background-color: #244163; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Nueva reserva" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
